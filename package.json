{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "prebuild": "rm -f public/hot",
        "build": "tsc && vite build",
        "dev": "vite",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --ext ts,tsx --fix",
        "type-check": "tsc --noEmit",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:http-integration": "vitest run --config vitest.http-integration.config.ts",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:auth:central": "playwright test tests/e2e/central-auth-flow.spec.ts",
        "test:e2e:auth:tenant": "playwright test tests/e2e/tenant-auth-flow.spec.ts",
        "test:e2e:auth": "playwright test tests/e2e/central-auth-flow.spec.ts tests/e2e/tenant-auth-flow.spec.ts tests/e2e/tenant-permissions.spec.ts",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:report": "playwright show-report",
        "opencode:health": "node scripts/opencode/health.mjs",
        "opencode:models": "node scripts/opencode/list-models.mjs",
        "opencode:event": "node scripts/opencode/event-monitor.mjs",
        "opencode:run-packet": "node scripts/opencode/run-packet.mjs",
        "opencode:last-artifact": "node scripts/opencode/last-artifact.mjs",
        "opencode:parse-result": "php scripts/opencode/parse-result.php",
        "opencode:run-loop": "bash scripts/opencode/run-loop.sh",
        "opencode:dispatch": "php scripts/opencode/dispatch.php",
        "opencode:run-auto": "node scripts/opencode/run-auto.mjs",
        "opencode:git-finalize": "bash scripts/opencode/git-finalize.sh",
        "opencode:state:init": "php scripts/opencode/state.php init",
        "opencode:state:ingest-packet": "php scripts/opencode/state.php ingest-packet",
        "opencode:state:ingest-latest": "php scripts/opencode/state.php ingest-latest",
        "opencode:state:context": "php scripts/opencode/state.php context",
        "opencode:state:report": "php scripts/opencode/state.php report",
        "opencode:state:backfill": "php scripts/opencode/state.php backfill-runs",
        "opencode:state:calibrate": "php scripts/opencode/state.php calibrate-routing",
        "opencode:state:route-upsert": "php scripts/opencode/state.php route-upsert",
        "opencode:state:route-list": "php scripts/opencode/state.php route-list",
        "opencode:state:record-failure": "php scripts/opencode/state.php record-failure",
        "opencode:state:verify": "bash scripts/opencode/state-verify.sh --packet .opencode/DEVELOPMENT_DOCS/execution/packet.yaml",
        "opencode:state:build-packet": "php scripts/opencode/state.php build-packet",
        "opencode:state:ingest-all": "php scripts/opencode/state.php ingest-all",
        "opencode:task:create": "php scripts/opencode/state.php task:create",
        "opencode:task:list": "php scripts/opencode/state.php task:list",
        "opencode:task:show": "php scripts/opencode/state.php task:show",
        "opencode:task:complete": "php scripts/opencode/state.php task:complete",
        "opencode:task:block": "php scripts/opencode/state.php task:block",
        "opencode:task:unblock": "php scripts/opencode/state.php task:unblock",
        "opencode:task:ingest-packet": "php scripts/opencode/state.php task:ingest-packet",
        "opencode:plan:list": "php scripts/opencode/state.php plan:list",
        "opencode:plan:show": "php scripts/opencode/state.php plan:show",
        "opencode:plan:ingest": "php scripts/opencode/state.php plan:ingest",
        "opencode:ref:list": "php scripts/opencode/state.php ref:list",
        "opencode:ref:show": "php scripts/opencode/state.php ref:show",
        "opencode:ref:ingest": "php scripts/opencode/state.php ref:ingest",
        "opencode:broker-verify": "bash scripts/opencode/broker-verify.sh",
        "opencode:broker-verify:full": "bash scripts/opencode/broker-verify.sh --full"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@tailwindcss/vite": "^4.1.14",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24.7.0",
        "@types/react": "^18.3.25",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/ui": "^3.2.4",
        "axios": "^1.12.2",
        "concurrently": "^9.2.1",
        "eslint": "^9.37.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.23",
        "globals": "^16.4.0",
        "jsdom": "^27.0.0",
        "laravel-vite-plugin": "^2.0.1",
        "tailwindcss": "^4.1.14",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.45.0",
        "vite": "^7.1.9",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@headlessui/react": "^2.2.9",
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^3.10.0",
        "@puckeditor/core": "^0.21.2",
        "@radix-ui/react-avatar": "^1.1.10",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-direction": "^1.1.1",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-tabs": "^1.1.13",
        "@stripe/react-stripe-js": "^6.1.0",
        "@stripe/stripe-js": "^9.1.0",
        "@tailwindcss/forms": "^0.5.10",
        "@tanstack/react-query": "^5.90.2",
        "@types/recharts": "^1.8.29",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "i18next": "^25.8.14",
        "i18next-browser-languagedetector": "^8.2.1",
        "lucide-react": "^0.544.0",
        "react": "^18.3.1",
        "react-colorful": "^5.6.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.64.0",
        "react-i18next": "^16.5.6",
        "react-router-dom": "^6.30.1",
        "recharts": "^3.7.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^2.6.0",
        "vanilla-cookieconsent": "^3.1.0",
        "zod": "^3.25.76",
        "zustand": "^5.0.8"
    }
}
