# Copy this file to the staging host as the starting point for `.env`.
# Keep real secrets on the server or in the secret manager, not in git.

APP_NAME=ByteForge
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://stage.byteforge.se
TENANCY_CENTRAL_DOMAINS=stage.byteforge.se
TENANCY_FALLBACK_TENANT_DOMAIN_TEMPLATE=:tenant.stage.byteforge.se

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=byteforge_staging
DB_USERNAME=byteforge_staging_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

AUTH_REFRESH_COOKIE_NAME=byteforge_refresh
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_TTL_MINUTES=20160
AUTH_REFRESH_COOKIE_SAME_SITE=lax

GUEST_MAGIC_LINK_TTL_MINUTES=30
GUEST_ACCESS_TOKEN_TTL_MINUTES=15
GUEST_AUTH_REFRESH_COOKIE_NAME=byteforge_guest_refresh
GUEST_AUTH_REFRESH_COOKIE_PATH=/api/guest-auth
GUEST_AUTH_REFRESH_TTL_MINUTES=20160
GUEST_AUTH_REFRESH_COOKIE_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=qa@byteforge.se
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=stage.byteforge.se

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ADDON_BOOKING=
STRIPE_PRICE_ADDON_PAYMENTS=
STRIPE_PRICE_ADDON_ANALYTICS_PRO=
STRIPE_PRICE_ADDON_PRIORITY_SUPPORT=
STRIPE_PRICE_ADDON_ESTIMATES_QUOTES=
CASHIER_CURRENCY=sek
CASHIER_CURRENCY_LOCALE=sv_SE

VITE_APP_NAME="${APP_NAME}"
VITE_CENTRAL_DOMAINS=stage.byteforge.se
